# Copy this file to `.secrets` in this folder, then fill in your values:
#   cp .secrets.example .secrets
# `.secrets` is gitignored — it never leaves your machine and is never committed.
# Format: KEY="value", one per line. Lines starting with # are ignored.
#
# The keys below match the secret_name entries in wrangler.toml (the SPARK_
# prefix is this repo's secret-store naming convention).

SPARK_COOKIE_SECRET=""
SPARK_HELIX_ORIGIN_AUTHENTICATION=""
SPARK_DM_CLIENT_ID=""
SPARK_DM_CLIENT_SECRET=""
